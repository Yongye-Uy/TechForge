# ============================================================================
# TechForge Store Configuration
# ============================================================================

# Server Port (Default: 3000)
PORT=3000

# Secret Key for JWT Authentication
JWT_SECRET=techforge_super_secure_jwt_secret_2026

# Supabase PostgreSQL Connection String
# ----------------------------------------------------------------------------
# How to get your Supabase Connection String:
# 1. Go to your Supabase Project -> Project Settings -> Database.
# 2. Under "Connection string", select "URI".
# 3. Choose "Session pooler" (port 5432) or "Transaction pooler" (port 6543)
# 4. Copy the string and replace [YOUR-PASSWORD] with your database password.
#
# Format:
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Telegram Admin Notification Bot
# 1. Create a bot with @BotFather to get your token
# 2. Get your user Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
